{
	"name": "myst-version-switcher-plugin",
	"private": true,
	"description": "A pydata-style version switcher for MyST, as a single anywidget plugin, plus reusable CI workflows that reconstruct and deploy the versioned site.",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/DiamondLightSource/myst-version-switcher-plugin.git"
	},
	"scripts": {
		"test": "node test/test-url-logic.mjs && node test/test-assemble.mjs",
		"docs": "cd docs && myst build --html --strict",
		"docs-dev": "cd docs && myst start",
		"test:workflows": "uv run --quiet --with pyyaml python3 test/workflow-harness/test_gather.py"
	},
	"files": [
		"plugins/version-switcher.mjs",
		"assemble/assemble.mjs"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@j178/prek": "^0.4.0",
		"mystmd": "1.10.1"
	}
}
